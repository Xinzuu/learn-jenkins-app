pipeline {
    agent any

    stages {
        stage('Build') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
               sh '''
                ls -la
                node --version
                npm --version
                npm ci
                npm run build
               '''
            }
        }
        stage('Test'){

            steps{
                sh '''
                test npm
                echo "test stage"
                test -f build/index.html && echo " found index.html exist || echo "html file not found"

                '''
            }

        }
    }
}
