pipeline {
    agent any

    environment{
        NETLIFY_SITE_ID= ""
        NETLIFY_AUTH_TOKEN= ""
    }

    stages {
        stage('Build') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
               sh '''
                ls -la
                node --version
                npm --version
                npm ci
                npm run build
                ls -la

               '''
            }
        }
        stage('Test'){
            parallel {
                stage('unit test'){
                    agent{
                        docker{
                            image 'node:18-alpine'
                            reuseNode true
                        }
                    }

                }
                steps{
                    sh '''
                        #test -f build/index.html
                        npm test
                    '''
                }
            }
            

        }
    }

    post {
        always{
            junit 'jest-result/junit.xml'
        }
    }
}


